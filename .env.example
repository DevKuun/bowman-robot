# Bowman Robot Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=bowman-robot
APP_ENV=development
DEBUG=false

# Database Settings
# DB_TYPE: sqlite (default, no setup required) or postgresql
DB_TYPE=sqlite
DB_PATH=data/bowman.db

# PostgreSQL Database (only used when DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bowmandb
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# API Key Encryption
# ENCRYPTION_TYPE: auto (default), kms, local, or none
# - auto: uses KMS if KMS_KEY_ID is set, otherwise local
# - kms: AWS KMS encryption (requires AWS settings below)
# - local: Fernet encryption (uses ENCRYPTION_SECRET)
# - none: no encryption (base64 only, NOT recommended for production)
ENCRYPTION_TYPE=auto
ENCRYPTION_SECRET=your-secret-phrase-for-local-encryption

# AWS KMS Settings (only used when ENCRYPTION_TYPE=kms or auto with KMS_KEY_ID)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-2
KMS_KEY_ID=your_kms_key_id
KMS_ENCRYPT_ALGORITHM=RSAES_OAEP_SHA_256

# Slack Notifications
SLACK_TOKEN=xoxb-your-slack-token
SLACK_CHANNEL_ID=your_channel_id
SLACK_ENABLED=true

# Trading Parameters
TRADING_WINDOW_YEARS=2
TRADING_TH_TRD_RATE=0.0001
TRADING_TH_PTF_RATE=0.001
TRADING_MAX_PERIOD_SECONDS=60

# Upbit Exchange Settings
UPBIT_FEE_KRW=0.0005
UPBIT_FEE_BTC=0.0025
UPBIT_MIN_TRADE_KRW=5000
UPBIT_MIN_TRADE_BTC=0.00005
UPBIT_MIN_TRADE_USDT=0.5

# Binance Exchange Settings
BINANCE_FEE_DISCOUNT=0.25
BINANCE_REFERRAL_KICKBACK=0.2

# Bithumb Exchange Settings
BITHUMB_FEE=0.0004
BITHUMB_MIN_TRADE_KRW=5000

# Worker Settings
WORKER_DB_REFRESH_INTERVAL=5
WORKER_BINANCE_REFRESH_INTERVAL=3
WORKER_MAX_CONCURRENT_USERS=100

# Risk Levels
RISK_LEVELS=5

# Upbit Multi-Market Settings
UPBIT_MARKETS=["KRW", "BTC", "USDT"]
UPBIT_PRIMARY_MARKET=KRW
UPBIT_AUTO_CONVERT_TO_KRW=true

# Portfolio Optimization Settings
PORTFOLIO_MIN_DAILY_VOLUME_KRW=1000000000
PORTFOLIO_REOPTIMIZE_HOURS=24
